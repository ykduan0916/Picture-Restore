# 数据库配置
DATABASE_URL=postgresql+asyncpg://dev:dev_password@localhost:5432/picture_renew_dev

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# S3 兼容对象存储
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=picture-renew-dev
S3_REGION=us-east-1

# API 配置
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=1

# 应用配置
ENVIRONMENT=development
LOG_LEVEL=INFO

# 执行策略（开发环境默认禁用付费调用）
PAID_CALLS_ENABLED=false
PROVIDER_MODE=mock

# 模型供应商（生产环境配置）
# MODEL_GATEWAY_URL=http://192.168.11.88:3000
# MODEL_GATEWAY_KEY=your_api_key_here
